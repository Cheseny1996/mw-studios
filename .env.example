# Use a separate development database. Never point local development at production.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mzima_wells?retryWrites=true&w=majority
AUTH_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000

# Shop product uploads use Vercel Blob. Set BLOB_READ_WRITE_TOKEN by linking a Blob store.
BLOB_READ_WRITE_TOKEN=

# Safaricom Daraja settings. Use credentials matching the selected environment.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-domain.example/api/shop/mpesa/callback
